#!/bin/bash
set -Eeuo pipefail
export PATH="/var/apps/nodejs_v24/target/bin:$PATH"
export wizard_data_dir="${wizard_data_dir:-}" wizard_backup_dir="${wizard_backup_dir:-}"
INIT_STAGE="初始化安装设置"
MIGRATE_STAGE="迁移旧数据目录到所选位置"
MIGRATION_ARGS=()
# Existing configured user data is authoritative; never re-merge a stale legacy copy.
if [ -f "${TRIM_PKGETC:-${TRIM_PKGVAR:?}}/install-options.json" ]; then
  MIGRATION_ARGS+=(--preserve-existing)
fi
migrate_error() {
  local rc=$?
  [ "$rc" -ne 0 ] || rc=1
  local message="DeepSeek Harness 安装后处理失败：${1}（退出码 ${rc}）。旧数据目录未改动，请保留现场不要卸载重装。"
  printf "%s\n" "$message" >&2
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then printf "%s\n" "$message" >> "$TRIM_TEMP_LOGFILE"; fi
  exit "$rc"
}
trap migrate_error ERR
# fnOS exports wizard fields; keep values out of shell evaluation.
# init 退出码语义（0.3.97 加固）：
#   0 = 设置已保存且目录授权检查通过；
#   2 = 设置已保存但数据/备份目录尚未满足应用账号授权（目录授权属运行时门禁，
#       supervisor boot 会明确提示并阻止启动）——不再让整个安装报"未知错误"；
#   其它非零 = 真失败（配置写不进去等），维持 trap 报错。
set +e
node "${TRIM_APPDEST:?}/install-options-cli.js" init > "${TRIM_TEMP_LOGFILE:-/dev/stderr}" 2>&1
init_rc=$?
set -e
if [ "$init_rc" -eq 0 ]; then
  :
elif [ "$init_rc" -eq 2 ]; then
  printf "安装设置已保存；数据/备份目录尚未授权给应用账号，首次启动将被阻止。请在应用中心 → DeepSeek Harness → 访问权限中授权后重启应用。\n" | tee -a "${TRIM_TEMP_LOGFILE:-/dev/null}" >&2
else
  migrate_error "$INIT_STAGE"
fi
# A pre-existing install keeps its data in TRIM_PKGVAR. When the wizard chose a
# new data directory, carry the old user data over before the first boot; the
# old directory is preserved untouched as a rollback.
MIGRATION_ARGS=("${MIGRATION_ARGS[@]}")
if [ -n "${TRIM_PKGVAR:-}" ]; then
  FNOS_APP_DIR="${TRIM_APPDEST}" FNOS_DATA_DIR="${TRIM_PKGVAR}" TRIM_PKGETC="${TRIM_PKGETC:-}" \
    node "${TRIM_APPDEST}/install-migration-cli.js" "${MIGRATION_ARGS[@]}" >> "${TRIM_TEMP_LOGFILE:-/dev/stderr}" 2>&1
fi
