#!/bin/bash
set -u

export PATH="/var/apps/nodejs_v24/target/bin:$PATH"
# Normalize aliases once; /proc ownership compares the same canonical roots.
DATA_DIR="$(readlink -m -- "${TRIM_PKGVAR:?}")" || exit 1
APP_DIR="$(readlink -e -- "${TRIM_APPDEST:?}")" || exit 1
[ "$DATA_DIR" != / ] && [ "$APP_DIR" != / ] || exit 1
PID_FILE="$DATA_DIR/supervisor.pid"
PID_START_FILE="$DATA_DIR/supervisor.pid.starttime"
LOG_FILE="$DATA_DIR/supervisor.log"
STATE_FILE="$DATA_DIR/state.json"
GUIDE_SOCKET="$APP_DIR/guide.sock"
SERVICE_PORT="${TRIM_SERVICE_PORT:-3080}"
CORE_PORT="${FNOS_CORE_PORT:-3081}"

# One ownership implementation for discovery, waiting and EVERY signal. Tokens
# are pid:starttime:role; never turn an old pid into a fresh generation at KILL.
owner_query() {
  node -e '
    try {
    const o = require(process.argv[1]);
    const [mode, data, app, token, extra] = process.argv.slice(2);
    const decode = t => { const [pid,starttime,role] = (t || "").split(":"); return {pid:Number(pid),starttime,role}; };
    const encode = i => `${i.pid}:${i.starttime}:${i.role}`;
    if (mode === "scan") console.log(o.ownedProcesses(data, app).filter(i => !token || i.role === token).map(encode).join(" "));
    else if (mode === "listener") console.log(o.ownedListenerIdentities(Number(token), data, app).map(encode).join(" "));
    else if (mode === "check") process.exit(o.identityMatches(decode(token), data, app) ? 0 : 1);
    else if (mode === "signal") process.exit(o.signalOwned(decode(token), extra, data, app) ? 0 : 1);
    else if (mode === "birth") { const s = o.processStarttime(token); if (!s) process.exit(1); console.log(`${token}:${s}:supervisor`); }
    else if (mode === "pid") { const i = o.processIdentity(token, data, app); if (!i || i.role !== "supervisor" || (extra && extra !== i.starttime)) process.exit(1); console.log(encode(i)); }
    else if (mode === "save") {
      const fs = require("node:fs"), path = require("node:path"); const i = decode(token);
      if (i.role !== "supervisor" || !o.identityMatches(i, data, app)) process.exit(1);
      // Numeric pidfile remains compatible with supervisor/legacy tools.
      for (const [name,value] of [["supervisor.pid.starttime",i.starttime],["supervisor.pid",String(i.pid)]]) {
        const target = path.join(data,name), tmp = `${target}.pending-${process.pid}`;
        fs.writeFileSync(tmp,value + "\n",{mode:0o600,flag:"wx"}); fs.chmodSync(tmp,0o600); fs.renameSync(tmp,target);
      }
    }
    } catch (error) { console.error(error.message); process.exit(2); }
  ' "$APP_DIR/port-owner.js" "$1" "$DATA_DIR" "$APP_DIR" "${2:-}" "${3:-}"
}

supervisor_pids() { owner_query scan supervisor; }
pid_is_our_supervisor() { owner_query pid "$1" "${2:-}"; }

# status is strictly read-only: discovery does NOT repair the pidfile.
running() {
  local pid birth="" rc tokens
  if [ -f "$PID_FILE" ]; then
    pid="$(< "$PID_FILE")"
    [ ! -f "$PID_START_FILE" ] || birth="$(< "$PID_START_FILE")"
    pid_is_our_supervisor "$pid" "$birth" >/dev/null; rc=$?
    [ "$rc" = 0 ] && return 0
    [ "$rc" -le 1 ] || return 2
  fi
  tokens="$(supervisor_pids)" || return 2
  [ -n "$tokens" ]
}

repair_pidfile() {
  local tokens token
  tokens="$(supervisor_pids)" || return 1
  token="${tokens%% *}"
  [ -n "$token" ] && owner_query save "$token"
}

# Resolve actual saved ports. Corrupt/invalid settings are preserved and fall
# back, matching ops.portSettings rather than aborting before safe control UI.
reclaim_ports() {
  node -e '
    const fs = require("node:fs"), path = require("node:path"); let saved = {};
    try { saved = JSON.parse(fs.readFileSync(path.join(process.argv[1],"port-settings.json"),"utf8")) || {}; } catch {}
    const valid = p => Number.isInteger(Number(p)) && Number(p) >= 1024 && Number(p) <= 65535;
    const ports = [valid(saved.publicPort) ? Number(saved.publicPort) : Number(process.argv[2]), valid(saved.corePort) ? Number(saved.corePort) : Number(process.argv[3])];
    console.log([...new Set(ports.filter(p => Number.isInteger(p) && p > 0 && p <= 65535))].join(" "));
  ' "$DATA_DIR" "$SERVICE_PORT" "$CORE_PORT"
}

own_listener_present() { [ -n "$(owner_query listener "$1")" ]; }

# Verify the resolved target before removal. Only ephemeral lifecycle artifacts
# are allowed: never sessions, port settings, profile config or user data.
safe_remove() {
  local file expected resolved
  for file in "$@"; do
    case "$file" in
      "$PID_FILE"|"$PID_START_FILE"|"$STATE_FILE") expected="$DATA_DIR/$(basename -- "$file")" ;;
      "$GUIDE_SOCKET") expected="$APP_DIR/guide.sock" ;;
      *) return 1 ;;
    esac
    resolved="$(readlink -m -- "$file")" || return 1
    [ "$resolved" = "$expected" ] || return 1
    if [ "$file" = "$GUIDE_SOCKET" ]; then
      node -e '
        const fs=require("node:fs"),net=require("node:net"),file=process.argv[1];
        try { if (!fs.lstatSync(file).isSocket()) process.exit(2); }
        catch(error) { process.exit(error.code === "ENOENT" ? 0 : 2); }
        const socket=net.connect(file);
        socket.setTimeout(1000);
        socket.once("connect",()=>{socket.destroy();console.error("Refuse unlink: gateway socket is live");process.exit(2)});
        socket.once("timeout",()=>{socket.destroy();process.exit(2)});
        socket.once("error",error=>process.exit(["ECONNREFUSED","ENOENT"].includes(error.code) ? 0 : 2));
      ' "$file" || return 1
    fi
  done
  # Validate the entire removal set before deleting even the pid/starttime record.
  for file in "$@"; do rm -f -- "$file" || return 1; done
}

stop_tokens() {
  local tokens="$1" grace="$2" token i alive rc
  for token in $tokens; do
    owner_query signal "$token" SIGTERM; rc=$?
    [ "$rc" -le 1 ] || return 1
  done
  for ((i=0; i<grace; i++)); do
    alive=0
    for token in $tokens; do
      owner_query check "$token"; rc=$?
      case "$rc" in 0) alive=1 ;; 1) ;; *) return 1 ;; esac
    done
    [ "$alive" = 0 ] && break
    sleep 1
  done
  for token in $tokens; do
    owner_query check "$token"; rc=$?
    case "$rc" in
      0) owner_query signal "$token" SIGKILL; rc=$?; [ "$rc" -le 1 ] || return 1 ;;
      1) ;; *) return 1 ;;
    esac
  done
  for ((i=0; i<5; i++)); do
    alive=0
    for token in $tokens; do
      owner_query check "$token"; rc=$?
      case "$rc" in 0) alive=1 ;; 1) ;; *) return 1 ;; esac
    done
    [ "$alive" = 0 ] && return 0
    sleep 1
  done
  return 1
}

reclaim_own_stragglers() {
  local live tokens port found remaining
  live="$(supervisor_pids)" || return 1
  if [ -n "$live" ]; then
    echo "DeepSeek Harness: supervisor still running ($live); skip reclaim" >> "$LOG_FILE"
    return 1
  fi
  # Exact role scans also reclaim non-listening gateway/core children after a
  # supervisor crash. Port discovery uses SAVED public/core values, not 308x.
  tokens="$(owner_query scan)" || return 1
  for port in $(reclaim_ports); do
    found="$(owner_query listener "$port")" || return 1
    tokens="$tokens $found"
  done
  tokens="$(printf '%s\n' $tokens | sort -u | tr '\n' ' ')"
  if [ -n "${tokens// /}" ]; then
    echo "DeepSeek Harness: reclaiming own leftover generations: $tokens" >> "$LOG_FILE"
    stop_tokens "$tokens" 10 || return 1
  fi
  remaining="$(owner_query scan)" || return 1
  [ -z "$remaining" ] || return 1
  safe_remove "$PID_FILE" "$PID_START_FILE" "$GUIDE_SOCKET"
}

control_ready() {
  [ -f "$STATE_FILE" ] && [ -S "$GUIDE_SOCKET" ] || return 1
  # Merely finding an old socket inode is not proof of a live control plane.
  node -e '
    const s = require("node:net").connect(process.argv[1]);
    s.setTimeout(1000); s.once("connect",()=>{s.destroy();process.exit(0)});
    s.once("error",()=>process.exit(1)); s.once("timeout",()=>{s.destroy();process.exit(1)});
  ' "$GUIDE_SOCKET" 2>/dev/null
}

start_app() {
  running; local running_rc=$?
  if [ "$running_rc" = 0 ]; then repair_pidfile || true; return 0; fi
  [ "$running_rc" = 1 ] || return 1
  if ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 24 ? 0 : 1)'; then
    echo "DeepSeek Harness requires the fnOS App Center nodejs_v24 dependency." > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    return 1
  fi
  reclaim_own_stragglers || return 1
  running; running_rc=$?
  if [ "$running_rc" = 0 ]; then repair_pidfile || true; return 0; fi
  [ "$running_rc" = 1 ] || return 1
  local port
  for port in $(reclaim_ports); do
    if own_listener_present "$port"; then
      echo "DeepSeek Harness: own listener still holds port $port after reclaim" >> "$LOG_FILE"
      return 1
    fi
  done
  safe_remove "$STATE_FILE" "$GUIDE_SOCKET" || return 1
  local instance_preload
  instance_preload="$(node -e 'console.log(require(process.argv[1]).instancePreload(process.argv[2]))' "$APP_DIR/port-owner.js" "$DATA_DIR")" || return 1
  FNOS_APP_DIR="$APP_DIR" FNOS_DATA_DIR="$DATA_DIR" FNOS_CONFIG_DIR="${TRIM_PKGETC:-}" \
    GUIDE_SOCKET="$GUIDE_SOCKET" FNOS_PORT="$SERVICE_PORT" \
    DSH_HOME="${DATA_DIR}/dsh-home" \
    node --require "$instance_preload" "$APP_DIR/supervisor.js" 9>&- >> "$LOG_FILE" 2>&1 &
  local launch_pid="$!" launch_token="" i
  launch_token="$(owner_query birth "$launch_pid")"
  # Always keep the launch generation, even when node exits before identity is
  # readable. The cleanup below must STILL run the orphan recovery path.
  for ((i=0; i<120; i++)); do
    if [ -n "$launch_token" ] && owner_query check "$launch_token"; then
      owner_query save "$launch_token" || break
      if control_ready && owner_query check "$launch_token"; then return 0; fi
    else
      break
    fi
    sleep 1
  done
  echo "DeepSeek Harness could not start; check supervisor.log." > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
  cleanup_failed_start "$launch_token"
  return 1
}

stop_app() {
  local tokens
  tokens="$(supervisor_pids)" || return 1
  stop_tokens "$tokens" 45 || return 1
  reclaim_own_stragglers || return 1
  safe_remove "$PID_FILE" "$PID_START_FILE" "$GUIDE_SOCKET"
}

cleanup_failed_start() {
  local token="$1"
  if [ -n "$token" ]; then
    echo "DeepSeek Harness: start failed; stopping launch generation $token" >> "$LOG_FILE"
    stop_tokens "$token" 20 || return 1
  fi
  # Do not return early just because the supervisor has already crashed.
  reclaim_own_stragglers || return 1
  safe_remove "$PID_FILE" "$PID_START_FILE" "$GUIDE_SOCKET" "$STATE_FILE"
}

case "${1:-}" in
  status) running; rc=$?; case "$rc" in 0) exit 0 ;; 1) exit 3 ;; *) exit 4 ;; esac ;;
  start|stop)
    # flock locks a persistent inode (never delete this file). Close fd 9 in
    # spawned supervisor so a daemon cannot keep the instance lock forever.
    if [ "${1}" = stop ] && [ ! -d "$DATA_DIR" ]; then exit 0; fi
    mkdir -p -- "$DATA_DIR" && chmod 700 "$DATA_DIR" || exit 1
    [ ! -L "$DATA_DIR/lifecycle.lock" ] || exit 1
    exec 9>"$DATA_DIR/lifecycle.lock" || exit 1
    flock -x -w 180 9 || exit 1
    touch "$LOG_FILE" && chmod 600 "$LOG_FILE" || exit 1
    if [ "$1" = start ]; then start_app; else stop_app; fi ;;
  *) echo "Unknown command: ${1:-}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"; exit 1 ;;
esac
